# Salesforce Connected App credentials
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=your_connected_app_consumer_key
SF_CLIENT_SECRET=your_connected_app_consumer_secret
SF_USERNAME=api-user@checkout.com
SF_PASSWORD=passwordPLUSsecuritytoken   # password concatenated with SFDC security token

# Slack app credentials
SLACK_SIGNING_SECRET=your_slack_app_signing_secret

# Server
PORT=8080
